{
  "name": "kartu-obrolan",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "dev": "vite",
    "generate:pwa-assets": "pwa-assets-generator",
    "generate:live": "node --env-file=.env.local scripts/generate-live-package.ts",
    "test": "pnpm run test:domain && pnpm run test:ui",
    "test:domain": "node --test test/question-generator.test.ts test/generate-question-package.test.ts",
    "test:ui": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.32",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "ai": "^7.0.50",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/json-schema": "^7.0.15",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vercel/node": "^5.9.5",
    "@vite-pwa/assets-generator": "1.0.0",
    "@vitejs/plugin-react": "^6.0.5",
    "jsdom": "^30.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "^4.1.10"
  }
}
